{
  "permissions": {
    "ask": ["Edit(CLAUDE.md)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/format-on-write.sh\""
          }
        ]
      }
    ]
  }
}
