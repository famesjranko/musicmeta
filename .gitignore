# VS Code Code Counter's output — a regenerable LOC report over the tree, not a record of it.
/.VSCodeCounter
.DS_Store
/build
/*/build
/captures
.externalNativeBuild
.cxx
local.properties
# Tracked: .claude/settings.json (the format-on-write hook), .claude/rules/ and .claude/commands/.
# A hook that is not committed does not reach worktrees or a fresh clone, which is most of where the
# agent works — and a command nobody else has is not wiring, it is a local habit.
.claude/*
!.claude/settings.json
!.claude/rules/
!.claude/commands/
.planning
.scratch
.out-of-scope
/prototype
# Third-party API surface reports and the tables derived from them. Working notes, not the repo's
# account of a provider — docs/providers.md is that. They date fast: an upstream's availability and
# routes change under you, so a committed copy would read as current long after it stopped being.
/research/
secrets.properties

# Python bytecode (scripts/)
__pycache__/
*.pyc

# graphify knowledge graph — regenerable from the tree, and the cache/ is large
graphify-out/
