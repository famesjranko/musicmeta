#!/usr/bin/env bash
# The single verification command. CI runs exactly this, so a green local run means a green build
# rather than a guess about one.
#
# Four layers, in the order they get cheaper to fix: a formatter, a linter, a type checker, and a
# custom linter for the rules no off-the-shelf tool checks. Ordered fastest-first so a style slip
# fails in a second rather than after a full Gradle build.
#
#   ./check              everything
#   ./check --fast       skip detekt, the build, the core dependency baseline, the demo canary and
#                        doc samples — edit loop, not a push
#   ./check --skip-demo  CI only: the demo canary is a separate required check there
set -euo pipefail
cd "$(dirname "$0")"

FAST=0
SKIP_DEMO=0
for arg in "$@"; do
    case "$arg" in
        --fast) FAST=1 ;;
        --skip-demo) SKIP_DEMO=1 ;;
        *) echo "usage: ./check [--fast] [--skip-demo]" >&2; exit 64 ;;
    esac
done

# A gate whose tool is missing must fail, not skip. Skipping reports green while checking nothing,
# which is worse than having no gate at all — VERIFICATION.md would then assert something false.
# Version, not just presence. bootstrap.sh pins these precisely because formatter output and
# lint rules differ between releases, so accepting any version on PATH reintroduces the local/CI
# disagreement the single command exists to remove.
#
# The pins are read out of bootstrap.sh rather than restated here: a second copy is what let the
# gate and the format-on-write hook drift apart on ktlint (#84). A rename or a removal there yields
# an empty pin, which fails below rather than matching every version.
pin() { # pin <bootstrap-variable>
    sed -n "s/^$1=\"\([^\"]*\)\"\$/\1/p" scripts/bootstrap.sh
}
bad=""
require() { # require <command> <pinned-version>
    if [ -z "$2" ]; then
        bad="$bad $1(no pin in scripts/bootstrap.sh)"
    elif ! command -v "$1" >/dev/null 2>&1; then
        bad="$bad $1(absent)"
    elif ! "$1" --version 2>/dev/null | grep -qE "(^|[^0-9.])${2//./\\.}([^0-9.]|$)"; then
        bad="$bad $1(want $2)"
    fi
}
require ruff "$(pin RUFF_VERSION)"
require mypy "$(pin MYPY_VERSION)"
require shellcheck "$(pin SHELLCHECK_VERSION)"

# node is a minimum major rather than an exact pin, so `require` cannot express it: it is the
# machine's runtime, not an executable bootstrap.sh fetches. Absent or too old fails here, because
# the alternative is the demo's browser tests silently not running.
node_min="$(pin NODE_MIN_MAJOR)"
if [ -z "$node_min" ]; then
    bad="$bad node(no pin in scripts/bootstrap.sh)"
elif ! command -v node >/dev/null 2>&1; then
    bad="$bad node(absent, want >=$node_min — install it; bootstrap.sh does not)"
elif [ "$(node --version | sed 's/^v\([0-9]*\).*/\1/')" -lt "$node_min" ]; then
    bad="$bad node($(node --version), want >=$node_min)"
fi
if [ -n "$bad" ]; then
    echo "tooling mismatch:$bad" >&2
    echo "run ./scripts/bootstrap.sh to install the pinned versions" >&2
    exit 127
fi

# The android module needs an SDK. Falling back to the conventional location turns a cryptic
# Gradle failure into a working run on a normally-configured machine.
if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Android/Sdk" ]; then
    export ANDROID_HOME="$HOME/Android/Sdk"
fi

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

step "python format + lint (ruff)"
ruff format --check .
ruff check .

step "shell lint (shellcheck)"
# Discovered, not a fixed glob: a hand-listed set silently stops covering the next script someone
# adds, which is the same silent-skip failure this gate exists to prevent. `check` has no
# extension so it is named explicitly. `.claude/` is excluded because agent worktrees under it are
# whole copies of this repo — without that, every script gets linted once per live worktree.
find . -name '*.sh' -not -path './.git/*' -not -path './.claude/*' -not -path '*/build/*' \
    -print0 | sort -z | xargs -0 shellcheck check

step "python types (mypy)"
mypy

step "conventions"
python3 scripts/checks/check_conventions.py

step "pitfall citations"
python3 scripts/checks/check_pitfall_citations.py

step "provider call scope"
python3 scripts/checks/check_provider_call_scope.py

step "public vocabulary"
python3 scripts/checks/check_public_vocabulary.py

step "edition vocabulary"
python3 scripts/checks/check_edition_vocabulary.py

step "release coordinates"
# The version is declared once in gradle.properties and repeated in four docs. Read on every commit
# rather than at release time: the ROADMAP prose went a full release stale and sat unnoticed for
# three weeks, because the only thing that could have caught it ran after the release.
python3 scripts/checks/check_release_coordinates.py

step "script self-tests"
# Unguarded, a regression in a release script surfaces only as a release check that silently passes.
for t in scripts/checks/test_*.py scripts/github-workflows/test_*.py; do
    python3 "$t" >/dev/null 2>&1 || { python3 "$t"; exit 1; }
done
echo "all script self-tests pass"

step "demo frontend tests (node)"
# The demo's browser code was the one surface with no gate at all. Its wire-protocol reading and its
# "is this worth retrying" decision are pure functions precisely so this can run without a browser.
(cd demo-web && npm test --silent)

step "changelog release-note caps"
# The caps already existed in build_release_notes.py, but only ran at release prep — an over-long
# entry passed every local gate and failed in CI weeks later, in front of whoever was releasing
# rather than whoever wrote it. Same check_caps(), just called early. (03)
#
# Below the self-tests on purpose: this runs the script, so the test that proves the script is
# intact should have run first — otherwise a broken build_release_notes.py reports a green gate.
python3 scripts/github-workflows/build_release_notes.py Unreleased

step "test shape (given/when/then)"
# Below the self-tests for the same reason as the caps above: this runs check_test_shape.py, and a
# broken checker reporting a green gate is the failure this gate exists to prevent.
python3 scripts/checks/check_test_shape.py

step "kotlin format (ktlint)"
./gradlew ktlintCheck --quiet

if [ "$FAST" = 1 ]; then
    printf '\n\033[1m--fast: skipped detekt, the build, the core dependency baseline, the demo canary and doc samples\033[0m\n'
    exit 0
fi

step "kotlin static analysis (detekt, type-resolved)"
# Below the --fast exit for two reasons. detektMain/detektTest resolve the compiled classpath, so
# they compile Kotlin before they analyse — that is not an edit-loop cost — and the Android variants
# need ANDROID_HOME, which nothing above this line does. The edit loop keeps ktlint and
# check_conventions.py, which is where the `!!` ban lives — detekt cannot see one on a Java
# platform type, so the two are not interchangeable (#60).
#
# `./gradlew build` below runs these again through Gradle's `check`. They are up-to-date by then;
# running them here buys a named failure before a full compile-and-test cycle.
./gradlew detektMain detektTest detektTestFixtures --quiet

step "build (compile, test, apiCheck)"
./gradlew build

step "core dependency baseline (published POM)"
# Beside apiCheck because it is the same shape of gate on the same artifact, and below --fast
# because it needs Gradle. apiCheck reads the ABI and a transitive is not in it: a dependency added
# to core moves no api/*.api line and reaches every consumer at the next release, where removing it
# is a break. Generating the POM here rather than trusting build/ means a stale or absent build
# directory fails the diff's input instead of the diff.
./gradlew :musicmeta-core:generatePomFileForMavenPublication --quiet
python3 scripts/checks/check_pom_dependencies.py

# demo-cli/ is a separate composite build that `./gradlew build` never compiles, so this is the only
# in-tree consumer compiling the way an external one does. It has no wrapper — it borrows the root.
#
# --skip-demo exists for CI only, where `demo-canary` is a separate required status check and
# would otherwise compile this twice. Locally the default runs it, so one command still covers
# everything and a green local run stays a superset of what CI verifies (CI's demo-canary job
# runs `test` but not `ktlintCheck`).
if [ "$SKIP_DEMO" = 1 ]; then
    printf '\n\033[1m--skip-demo: demo canary left to its own CI job\033[0m\n'
else
    step "demo canary"
    # ktlintCheck before test: demo-cli/ is exempt from house *conventions* (see
    # check_conventions.py) but not from formatting — it is the worked example, and nothing about
    # style affects the canary's job. test after ktlintCheck so a formatting failure reports first.
    # demo-cli/ has no test sources yet; Gradle's test task reports NO-SOURCE and passes rather
    # than failing.
    (cd demo-cli && ../gradlew compileKotlin ktlintCheck test --quiet)
    # demo-web/ is the same shape: a separate composite build `./gradlew build` never compiles,
    # consuming the library like an external app. Without this line nothing gates its tests either.
    (cd demo-web && ../gradlew compileKotlin ktlintCheck test --quiet)
fi

# docs-samples/ is the same composite-build shape as demo-cli/demo-web, not a consumer canary: it
# compiles scripts/checks/check_doc_samples.py's extraction of every docs/guides/*.md Kotlin fence,
# so a sample that drifts from the real API fails here instead of only in a reader's own build.
step "doc samples"
(cd docs-samples && ../gradlew compileKotlin --quiet)

# docs-samples-android/ is the same extractor's Android-toolchain target: android.md's fences use
# Room/Hilt/WorkManager types a plain JVM module cannot see, so they compile here instead, against
# a real com.android.library build. No separate ANDROID_HOME gate: this needs the same SDK the
# android variants above already do, and fails the same way — loudly, not a silent skip — if it is
# absent.
step "doc samples (android)"
(cd docs-samples-android && ../gradlew compileDebugKotlin --quiet)

printf '\n\033[1;32mAll checks passed.\033[0m\n'
