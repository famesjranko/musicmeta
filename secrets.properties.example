# Copy to secrets.properties (repo root, or next to the demo you're running) and fill in.
# secrets.properties is gitignored. Lines left commented are treated as unset; those
# providers are skipped. Environment variables (LASTFM_API_KEY, FANARTTV_API_KEY,
# DISCOGS_TOKEN, LISTENBRAINZ_TOKEN) are the fallback when a key is missing here.

# Fanart.tv project key — https://fanart.tv/get-an-api-key/
# Enables ARTIST_BACKGROUND, ARTIST_LOGO, ARTIST_BANNER
#fanarttv.apikey=

# ListenBrainz user token — https://listenbrainz.org/settings/
# Enables ARTIST_RADIO_DISCOVERY
#listenbrainz.token=

# Last.fm API key — https://www.last.fm/api/account/create
#lastfm.apikey=

# Discogs personal access token — https://www.discogs.com/settings/developers
#discogs.token=

# Cloud Run build source (read by demo-web/deploy.sh at BUILD time, not by the app). Empty or
# commented builds musicmeta-core from this checkout — the only image that compiles while demo-web
# uses [Unreleased] core API. A version pins that published Maven Central release instead. Flip the
# deployed build source by changing this value and rerunning deploy.sh; no other edit.
#demo.core.version=

# Cloud Run deployment target (read by demo-web/deploy.sh; not committed to the repo, which carries
# no project identifiers). All three are required for a real deploy; env vars of the same name win.
# demo.gcp.service_account is optional — it defaults to musicmeta-demo-run@<project>.
#demo.gcp.project=
#demo.gcp.region=
#demo.gcp.service=
#demo.gcp.service_account=
