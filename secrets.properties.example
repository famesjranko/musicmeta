# Copy to secrets.properties (repo root, or next to the demo you're running) and fill in.
# secrets.properties is gitignored. Lines left commented are treated as unset; those
# providers are skipped. Environment variables (LASTFM_API_KEY, FANARTTV_API_KEY,
# DISCOGS_TOKEN, LISTENBRAINZ_TOKEN) are the fallback when a key is missing here.

# Fanart.tv project key — https://fanart.tv/get-an-api-key/
# Enables ARTIST_BACKGROUND, ARTIST_LOGO, ARTIST_BANNER
#fanarttv.apikey=

# ListenBrainz user token — https://listenbrainz.org/settings/
# Enables ARTIST_RADIO_DISCOVERY
#listenbrainz.token=

# Last.fm API key — https://www.last.fm/api/account/create
#lastfm.apikey=

# Discogs personal access token — https://www.discogs.com/settings/developers
#discogs.token=
